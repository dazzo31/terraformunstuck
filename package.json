{
  "name": "terraformunstuck",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "A visual Terraform learning guide and practical troubleshooting companion",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-syntax.mjs && node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:terraform": "node scripts/verify-terraform.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "ajv": "8.17.1"
  }
}
